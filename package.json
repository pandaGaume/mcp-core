{
    "name": "@cyanmycelium/mcp-core",
    "version": "0.5.0",
    "description": "Engine-neutral Model Context Protocol primitives: behaviors, adapters, grammars, server, transports, client and LLM bridge.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (CyanMycelium)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/mcp-core.git"
    },
    "homepage": "https://github.com/pandaGaume/mcp-core#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/mcp-core/issues"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "jsonrpc",
        "behavior",
        "grammar",
        "cyanmycelium"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js",
            "default": "./dist/server/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.js",
            "default": "./dist/client/index.js"
        },
        "./llm": {
            "types": "./dist/llm/index.d.ts",
            "import": "./dist/llm/index.js",
            "default": "./dist/llm/index.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "import": "./dist/node/index.js",
            "default": "./dist/node/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist",
        "compile": "tsc -b tsconfig.build.json",
        "watch": "tsc -b tsconfig.build.json -w",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "release:patch": "npm version patch && git push --follow-tags",
        "release:minor": "npm version minor && git push --follow-tags",
        "release:major": "npm version major && git push --follow-tags"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.0.1",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vitest": "^1.6.0"
    }
}
